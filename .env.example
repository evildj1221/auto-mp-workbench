# ============================================================
# 本地配置模板：复制为 .env 后填写。.env 绝不入库（.gitignore 已保护）
# ============================================================

# ---- LLM（文本生成：选题/写稿/评分/对话）----
# 推荐 DeepSeek（便宜稳定），也支持任何 OpenAI 兼容接口
# 申请：platform.deepseek.com → API keys
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-你的key
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 生图（头图/配图，可选；不配则出图功能优雅降级）----
# 火山方舟：console.volces.com → API Key
IMAGE_PROVIDER=ark
IMAGE_API_KEY=你的生图key
# IMAGE_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# IMAGE_MODEL=doubao-seedream-4-0
# 也可用 MiniMax（IMAGE_PROVIDER=minimax，支持风格参考图）

# ---- 微信公众号草稿箱推送（可选；不用推送可留空）----
# 申请：mp.weixin.qq.com → 设置与开发 → 基本配置
# ⚠️ 两项前置（详细步骤见 docs/rewrite/07-微信发布配置指南.md）：
#   1) AppSecret 点【重置】生成，只显示一次，立即复制到下面
#   2) **IP 白名单**：把你电脑的公网出口 IP 加进白名单，否则调用必失败
#      （报 40164 invalid ip）——注意家用/宿舍宽带重启后 IP 会变，
#      之后要重新加；推送前运行 python scripts/wechat_doctor.py 体检即可核对
WECHAT_APPID=wx开头的appid
WECHAT_APPSECRET=32位appsecret
# WECHAT_AUTHOR=你的笔名

# ---- 其他（可选）----
# FEISHU_DOC_FOLDER_TOKEN=   # 归档到飞书云文档的文件夹 token（不用留空）
